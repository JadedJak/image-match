# Copy to .env and fill in with your actual VeraCrypt drive-letter paths.
# Native Windows convention: run `docker compose` from PowerShell (not a
# WSL2 shell), and use forward-slash drive-letter paths -- Docker Desktop's
# WSL2 backend resolves these transparently, no separate file-sharing
# config needed for local NTFS/exFAT drives.
#
# IMPORTANT: mount all VeraCrypt volumes referenced below BEFORE running
# `docker compose up`/`run`. If a path doesn't exist yet, Docker silently
# creates an empty directory there instead of erroring -- you'd get a
# 0-file index with no obvious cause rather than a clear failure.

SOURCE_DIR_PERSONAL=F:/personal
INDEX_DIR_PERSONAL=F:/index_personal

SOURCE_DIR_GENERAL=G:/not_personal
INDEX_DIR_GENERAL=G:/index_general

# In-memory downsample cap (pixels, longest side) applied before hashing/
# embedding. Does not modify source files. 512 is a good default; raise it
# only if you switch to a larger CLIP model that wants more detail.
MAX_SIDE=512

# Set to this box's Tailscale IP (`tailscale ip -4`) to restrict each index
# to the tailnet only -- recommended over 0.0.0.0, which is also reachable
# on the LAN. Same IP for both -- it's this one host's tailnet address, not
# a per-category value. Defaults: GENERAL_BIND_HOST -> 0.0.0.0 if unset,
# PERSONAL_BIND_HOST -> 127.0.0.1 (this machine only) if unset -- the more
# locked-down default reflects what's normally in that catalog.
GENERAL_BIND_HOST=127.0.0.1
PERSONAL_BIND_HOST=127.0.0.1

# Indexer throughput tuning -- see README "I/O is the real bottleneck".
# Start with the defaults, watch the img/s + MB/s in the indexer log
# during your test run, and adjust from there.
IO_WORKERS=8
BATCH_SIZE=32

# Optional fast proxy cache (see README "Proxy cache on fast storage").
# Point these at the two separate encrypted VeraCrypt containers on your
# spare NVMe -- adjust drive letters to whatever they actually mount as.
# If left unset, proxies land in a project-local ./proxy-cache folder
# instead (still works, just not fast).
PROXY_DIR_GENERAL=H:/proxy-cache
PROXY_DIR_PERSONAL=I:/proxy-cache
PROXY_QUALITY=85

# Hover-preview target size/quality -- resized on the fly from the true
# source file per request (see the /img-preview route), never cached to
# disk. Deliberately separate from MAX_SIDE/PROXY_QUALITY above: those
# govern the small search-thumbnail proxy, which looks blurry once CSS
# stretches it to fill the preview overlay.
PREVIEW_MAX_SIDE=1600
PREVIEW_QUALITY=90

# Host folder holding the CLIP weights (see README "CLIP weight cache").
# Bind-mounted read-only into both containers -- populated once via the
# cache-warming command in the README, never written to by a normal
# container run. Not privacy-sensitive (public model weights, not your
# photos), so an unencrypted drive is fine here -- no need to burn space
# on a VeraCrypt volume for this one. Left unset, defaults to a
# project-local ./hf-cache folder.
HF_CACHE_DIR=D:/image-match/hf-cache

# Bulk match/upgrade-hunt tool (see README "Bulk matching low-quality
# images against the catalog") -- drop low-quality images in the input
# folder, run `matchfind general`/`matchfind personal`, and the best
# higher-resolution match for each (>= MATCH_SIMILARITY_THRESHOLD, found via
# the same index this app already builds) gets copied into the output
# folder. Left unset, both default to project-local ./match-input/<category>
# and ./match-output/<category> folders -- fine for occasional use, same
# fallback pattern as PROXY_DIR above. Point these at real drive paths only
# if you want them somewhere specific (e.g. alongside SOURCE_DIR_PERSONAL).
# MATCH_INPUT_DIR_PERSONAL=F:/match-input
# MATCH_OUTPUT_DIR_PERSONAL=F:/match-output
# MATCH_INPUT_DIR_GENERAL=G:/match-input
# MATCH_OUTPUT_DIR_GENERAL=G:/match-output
MATCH_SIMILARITY_THRESHOLD=0.90

# Which web UI to run: "nicegui" (default -- the primary UI, see
# app/ui_nicegui.py) or "gradio" (the original, kept working as a
# fallback, see app/ui.py). Switching this is just an env var + container
# recreate -- `image-match restart <category>` -- no rebuild required.
UI_ENGINE=nicegui
