# Copy to laptop/.env and edit. Same variables as the Windows .env, Linux
# paths. All folders must exist before `image-match up` (Podman errors on a
# missing one) -- mount any VeraCrypt volumes first.

SOURCE_DIR_GENERAL=/media/veracrypt1/general
INDEX_DIR_GENERAL=/media/veracrypt1/index_general
PROXY_DIR_GENERAL=/media/veracrypt1/proxy_general

SOURCE_DIR_PERSONAL=/media/veracrypt1/personal
INDEX_DIR_PERSONAL=/media/veracrypt1/index_personal
PROXY_DIR_PERSONAL=/media/veracrypt1/proxy_personal

# CLIP weights (~4GB, public -- needn't be encrypted). The install script
# copies them here; otherwise see the cache-warming command in the README.
HF_CACHE_DIR=/home/YOURUSER/image-match/hf-cache

# 127.0.0.1 = this laptop only. The laptop's Tailscale IP (`tailscale ip -4`)
# makes the UIs reachable from other tailnet devices (no auth in front).
GENERAL_BIND_HOST=127.0.0.1
PERSONAL_BIND_HOST=127.0.0.1

MAX_SIDE=512
PROXY_QUALITY=85

# Intel Arc GPU. fp16 is ~4x faster than fp32 here with near-identical
# results; pick it before the first full index run and keep it. DEVICE=cpu
# forces CPU (~25x slower) if the GPU path ever breaks after an update.
DEVICE=xpu
PRECISION=fp16
IO_WORKERS=8
BATCH_SIZE=16
MATCH_SIMILARITY_THRESHOLD=0.90
UI_ENGINE=nicegui
